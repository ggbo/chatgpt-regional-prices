{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggbo.github.io/chatgpt-regional-prices/schemas/snapshot.schema.json",
  "title": "Verified official monthly price snapshot",
  "type": "object",
  "required": ["schema_version", "data_snapshot_id", "generated_at", "catalog_version", "fx_snapshot_id", "quotes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "data_snapshot_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "catalog_version": {"type": "string"},
    "fx_snapshot_id": {"type": ["string", "null"]},
    "quotes": {"type": "array", "items": {"$ref": "#/$defs/quote"}}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "variant": {
      "type": "object",
      "required": ["amount", "tax", "json_pointer", "last_success_at", "price_changed_at"],
      "properties": {
        "amount": {"$ref": "#/$defs/decimal"},
        "tax": {"enum": ["inclusive", "exclusive", "unknown"]},
        "json_pointer": {"type": "string"},
        "last_success_at": {"type": "string", "format": "date-time"},
        "price_changed_at": {"type": "string", "format": "date-time"}
      }
    },
    "quote": {
      "type": "object",
      "required": ["record_id", "target_id", "country_code", "config_id", "channel", "plan_id", "billing_interval", "offer_type", "currency", "display_price", "psp_override_status", "availability", "source", "last_attempt_at", "last_success_at", "price_changed_at"],
      "properties": {
        "record_id": {"type": "string"},
        "country_code": {"type": ["string", "null"]},
        "channel": {"const": "web"},
        "plan_id": {"enum": ["go", "plus", "pro_100", "pro_200", "pro_500"]},
        "billing_interval": {"const": "month"},
        "offer_type": {"const": "standard"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "display_price": {"$ref": "#/$defs/variant"},
        "psp_override": {"anyOf": [{"$ref": "#/$defs/variant"}, {"type": "null"}]},
        "psp_override_status": {"enum": ["valid", "not_present", "invalid", "stale"]},
        "availability": {"type": "object", "required": ["configuration_present", "purchase_verified"], "properties": {"purchase_verified": {"const": false}}},
        "source": {"type": "object", "required": ["url", "body_sha256"], "properties": {"body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
      }
    }
  }
}
